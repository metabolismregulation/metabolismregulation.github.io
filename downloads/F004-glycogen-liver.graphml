          <data key="d121">IRS1; IRS2</data>
          <data key="d122">[{"symbol": "IRS1", "props": [["Full name", "Insulin receptor substrate 1"], ["Function", "Signaling adapter protein that participates in the signal transduction from two prominent receptor tyrosine kinases, insulin receptor/INSR and insulin-like growth factor I receptor/IGF1R. Plays therefore an important role in development, growth, glucose homeostasis as well as lipid metabolism."], ["Location", "Cytoplasm, Nucleus"], ["HGNC", "HGNC:6125"], ["HGNC symbol", "IRS1"], ["HGNC aliases", "HIRS-1"], ["Entrez", "3667"], ["Ensembl", "ENSG00000169047"], ["RefSeq", "NM_005544"], ["UniProt", "P35568"], ["Note", "Dominant in muscle and adipose tissue"]]}, {"symbol": "IRS2", "props": [["Full name", "Insulin receptor substrate 2"], ["Function", "Signaling adapter protein that participates in the signal transduction from two prominent receptor tyrosine kinases, insulin receptor/INSR and insulin-like growth factor I receptor/IGF1R. Plays therefore an important role in development, growth, glucose homeostasis as well as lipid metabolism."], ["Location", "Cytoplasm, cytosol"], ["HGNC", "HGNC:6126"], ["HGNC symbol", "IRS2"], ["Entrez", "8660"], ["Ensembl", "ENSG00000185950"], ["RefSeq", "NM_003749"], ["UniProt", "Q9Y4H2"], ["Note", "Dominant in liver and β-cells"]]}]</data>
