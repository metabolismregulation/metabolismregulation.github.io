            <node id="n1::n9::n1">
              <data key="d100">3-phosphoinositide-dependent protein kinase 1</data>
              <data key="d104">Serine/threonine kinase which acts as a master kinase, phosphorylating and activating a subgroup of the AGC family of protein kinases. Its targets include: protein kinase B (PKB/AKT1, PKB/AKT2, PKB/AKT3), p70 ribosomal protein S6 kinase (RPS6KB1), p90 ribosomal protein S6 kinase (RPS6KA1, RPS6KA2 and RPS6KA3), cyclic AMP-dependent protein kinase (PRKACA), protein kinase C (PRKCD and PRKCZ), serum and glucocorticoid-inducible kinase (SGK1, SGK2 and SGK3), p21-activated kinase-1 (PAK1), TSSK3, protein kinase PKN (PKN1 and PKN2).</data>
              <data key="d105">Cytoplasm, Nucleus, Cell membrane, Cell junction, focal adhesion</data>
              <data key="d107">HGNC:8816</data>
              <data key="d108">PDPK1</data>
              <data key="d109">PDK1</data>
