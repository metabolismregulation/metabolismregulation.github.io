          <data key="d121">PPP1CA; PPP1CB; PPP1CC</data>
          <data key="d122">[{"symbol": "PPP1CA", "props": [["Full name", "Serine/threonine-protein phosphatase PP1-alpha catalytic subunit"], ["Function", "Protein phosphatase that associates with over 200 regulatory proteins to form highly specific holoenzymes which dephosphorylate hundreds of biological targets. Protein phosphatase 1 (PP1) is essential for cell division, transcription elongation, and participates in the regulation of glycogen metabolism, muscle contractility and protein synthesis."], ["Location", "Cytoplasm, Nucleus, Nucleus, nucleoplasm, Nucleus, nucleolus, Postsynaptic density"], ["HGNC", "HGNC:9281"], ["HGNC symbol", "PPP1CA"], ["HGNC aliases", "PP1A, PP-1A, PP1alpha, PPP1A"], ["Entrez", "5499"], ["Ensembl", "ENSG00000172531"], ["RefSeq", "NM_002708"], ["UniProt", "P62136"], ["Note", "PP1α, ubiquitous"]]}, {"symbol": "PPP1CB", "props": [["Full name", "Serine/threonine-protein phosphatase PP1-beta catalytic subunit"], ["Function", "Protein phosphatase that associates with over 200 regulatory proteins to form highly specific holoenzymes which dephosphorylate hundreds of biological targets. Protein phosphatase (PP1) is essential for cell division, it participates in the regulation of glycogen metabolism, muscle contractility and protein synthesis."], ["Location", "Cytoplasm, Nucleus, Nucleus, nucleoplasm, Nucleus, nucleolus"], ["HGNC", "HGNC:9282"], ["HGNC symbol", "PPP1CB"], ["HGNC aliases", "PP1Cbeta, PPP1CD, PP1Cdelta, PP1B, PP-1B, PP1beta, PP1c, MP, PPP1beta"], ["Entrez", "5500"], ["Ensembl", "ENSG00000213639"], ["RefSeq", "NM_002709"], ["UniProt", "P62140"], ["Note", "PP1β, ubiquitous"]]}, {"symbol": "PPP1CC", "props": [["Full name", "Serine/threonine-protein phosphatase PP1-gamma catalytic subunit"], ["Alternative names", "Protein phosphatase 1C catalytic subunit"], ["Function", "Protein phosphatase that associates with over 200 regulatory proteins to form highly specific holoenzymes which dephosphorylate hundreds of biological targets. Protein phosphatase 1 (PP1) is essential for cell division, and participates in the regulation of glycogen metabolism, muscle contractility and protein synthesis."], ["Location", "Cytoplasm, Nucleus, Nucleus, nucleolus, Nucleus, nucleoplasm, Nucleus speckle, Chromosome, centromere, kinetochore, Cleavage furrow, Midbody, Mitochondrion, Cytoplasm, cytoskeleton, microtubule organizing center"], ["HGNC", "HGNC:9283"], ["HGNC symbol", "PPP1CC"], ["HGNC aliases", "PP1C, PP1gamma"], ["Entrez", "5501"], ["Ensembl", "ENSG00000186298"], ["RefSeq", "NM_001244974"], ["UniProt", "P36873"], ["Note", "PP1γ, ubiquitous"]]}]</data>
