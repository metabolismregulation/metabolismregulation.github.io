          <data key="d122">[{"symbol": "ADCY1", "props": [["Full name", "Adenylate cyclase type 1"], ["Alternative names", "ATP pyrophosphate-lyase 1; Adenylate cyclase type I; Adenylyl cyclase 1; Ca(2+)/calmodulin-activated adenylyl cyclase"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Mediates responses to increased cellular Ca(2+)/calmodulin levels."], ["Location", "Membrane, Cell membrane, Cytoplasm, Membrane raft"], ["HGNC", "HGNC:232"], ["HGNC symbol", "ADCY1"], ["HGNC aliases", "AC1, DFNB44"], ["Entrez", "107"], ["Ensembl", "ENSG00000164742"], ["RefSeq", "NM_021116"], ["UniProt", "Q08828"], ["Note", "Brain, Ca2+/calmodulin-stimulated"]]}, {"symbol": "ADCY2", "props": [["Full name", "Adenylate cyclase type 2"], ["Alternative names", "ATP pyrophosphate-lyase 2; Adenylate cyclase type II; Adenylyl cyclase 2"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Down-stream signaling cascades mediate changes in gene expression patterns and lead to increased IL6 production."], ["Location", "Membrane, Cell membrane, Cytoplasm"], ["HGNC", "HGNC:233"], ["HGNC symbol", "ADCY2"], ["HGNC aliases", "HBAC2, KIAA1060, AC2"], ["Entrez", "108"], ["Ensembl", "ENSG00000078295"], ["RefSeq", "NM_020546"], ["UniProt", "Q08462"], ["Note", "Brain and lung, Gβγ-stimulated"]]}, {"symbol": "ADCY3", "props": [["Full name", "Adenylate cyclase type 3"], ["Alternative names", "ATP pyrophosphate-lyase 3; Adenylate cyclase type III; Adenylate cyclase, olfactive type; Adenylyl cyclase 3"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Participates in signaling cascades triggered by odorant receptors via its function in cAMP biosynthesis: specifically activated by G alpha protein GNAL/G(olf) in olfactory epithelium."], ["Location", "Cell membrane, Cell projection, cilium membrane, Cell projection, cilium, Cytoplasm, Golgi apparatus"], ["HGNC", "HGNC:234"], ["HGNC symbol", "ADCY3"], ["HGNC aliases", "AC3"], ["Entrez", "109"], ["Ensembl", "ENSG00000138031"], ["RefSeq", "NM_001320613"], ["UniProt", "O60266"], ["Note", "Olfactory neurons and adipocytes"]]}, {"symbol": "ADCY4", "props": [["Full name", "Adenylate cyclase type 4"], ["Alternative names", "ATP pyrophosphate-lyase 4; Adenylate cyclase type IV; Adenylyl cyclase 4"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling"], ["Location", "Cell membrane, Cytoplasm"], ["HGNC", "HGNC:235"], ["HGNC symbol", "ADCY4"], ["HGNC aliases", "AC4"], ["Entrez", "196883"], ["Ensembl", "ENSG00000129467"], ["RefSeq", "NM_001198568"], ["UniProt", "Q8NFM4"], ["Note", "Broad expression, Gβγ-stimulated"]]}, {"symbol": "ADCY5", "props": [["Full name", "Adenylate cyclase type 5"], ["Alternative names", "ATP pyrophosphate-lyase 5; Adenylate cyclase type V; Adenylyl cyclase 5"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Mediates signaling downstream of ADRB1."], ["Location", "Cell membrane, Cell projection, cilium"], ["HGNC", "HGNC:236"], ["HGNC symbol", "ADCY5"], ["HGNC aliases", "AC5"], ["Entrez", "111"], ["Ensembl", "ENSG00000173175"], ["RefSeq", "NM_183357"], ["UniProt", "O95622"], ["Note", "Heart and striatum, Ca2+-inhibited"]]}, {"symbol": "ADCY6", "props": [["Full name", "Adenylate cyclase type 6"], ["Alternative names", "ATP pyrophosphate-lyase 6; Adenylate cyclase type VI; Adenylyl cyclase 6; Ca(2+)-inhibitable adenylyl cyclase"], ["Function", "Catalyzes the formation of the signaling molecule cAMP downstream of G protein-coupled receptors. Functions in signaling cascades downstream of beta-adrenergic receptors in the heart and in vascular smooth muscle cells."], ["Location", "Cell membrane, Cell projection, cilium, Cell projection, stereocilium"], ["HGNC", "HGNC:237"], ["HGNC symbol", "ADCY6"], ["HGNC aliases", "AC6"], ["Entrez", "112"], ["Ensembl", "ENSG00000174233"], ["RefSeq", "NM_020983"], ["UniProt", "O43306"], ["Note", "Broad expression, Ca2+-inhibited"]]}, {"symbol": "ADCY7", "props": [["Full name", "Adenylate cyclase type 7"], ["Alternative names", "ATP pyrophosphate-lyase 7; Adenylate cyclase type VII; Adenylyl cyclase 7; Cyclic di-AMP synthase ADCY7"], ["Function", "Adenylate cyclase that mediates formation of both cyclic AMP (cAMP) and cyclic di-AMP (c-di-AMP). Acts as a key mediator of G protein-coupled receptor signaling by catalyzing the formation of cAMP downstream of G protein-coupled receptors."], ["Location", "Membrane"], ["HGNC", "HGNC:238"], ["HGNC symbol", "ADCY7"], ["HGNC aliases", "KIAA0037, AC7"], ["Entrez", "113"], ["Ensembl", "ENSG00000121281"], ["RefSeq", "NM_001114"], ["UniProt", "P51828"], ["Note", "Immune cells"]]}, {"symbol": "ADCY8", "props": [["Full name", "Adenylate cyclase type 8"], ["Alternative names", "ATP pyrophosphate-lyase 8; Adenylate cyclase type VIII; Adenylyl cyclase 8; Ca(2+)/calmodulin-activated adenylyl cyclase"], ["Function", "Catalyzes the formation of cAMP in response to calcium entry leadings to cAMP signaling activation that affect processes suche as synaptic plasticity and insulin secretion. Plays a role in many brain functions, such as learning, memory, drug addiction, and anxiety modulation through regulation of synaptic plasticity by modulating long-term memory and long-term potentiation (LTP) through CREB transcription factor activity modulation."], ["Location", "Cell membrane, Basolateral cell membrane, Apical cell membrane, Synapse, Cell projection, dendrite, Cell projection, axon, Presynaptic cell membrane, Postsynaptic density, Membrane raft, Membrane, coated pit, Cytoplasmic vesicle, clathrin-coated vesicle membrane, Membrane, caveola"], ["HGNC", "HGNC:239"], ["HGNC symbol", "ADCY8"], ["HGNC aliases", "HBAC1, AC8, ADCY3"], ["Entrez", "114"], ["Ensembl", "ENSG00000155897"], ["RefSeq", "NM_001115"], ["UniProt", "P40145"], ["Note", "Brain, Ca2+/calmodulin-stimulated"]]}, {"symbol": "ADCY9", "props": [["Full name", "Adenylate cyclase type 9"], ["Alternative names", "ATP pyrophosphate-lyase 9; Adenylate cyclase type IX; Adenylyl cyclase 9"], ["Function", "Adenylyl cyclase that catalyzes the formation of the signaling molecule cAMP in response to activation of G protein-coupled receptors. Contributes to signaling cascades activated by CRH (corticotropin-releasing factor), corticosteroids and beta-adrenergic receptors"], ["Location", "Cell membrane"], ["HGNC", "HGNC:240"], ["HGNC symbol", "ADCY9"], ["HGNC aliases", "AC9"], ["Entrez", "115"], ["Ensembl", "ENSG00000162104"], ["RefSeq", "NM_001116"], ["UniProt", "O60503"], ["Note", "Broad expression, low forskolin response"]]}]</data>
