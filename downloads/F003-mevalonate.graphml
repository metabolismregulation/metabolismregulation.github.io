      <data key="d122">[{"symbol": "PPP2CA", "props": [["Full name", "Serine/threonine-protein phosphatase 2A catalytic subunit alpha isoform"], ["Alternative names", "Replication protein C"], ["Function", "Catalytic subunit of protein phosphatase 2A (PP2A), a serine/threonine phosphatase involved in the regulation of a wide variety of enzymes, signal transduction pathways, and cellular events. PP2A is the major phosphatase for microtubule-associated proteins (MAPs)."], ["Location", "Cytoplasm, Nucleus, Chromosome, Chromosome, centromere, Cytoplasm, cytoskeleton, spindle pole"], ["HGNC", "HGNC:9299"], ["HGNC symbol", "PPP2CA"], ["HGNC aliases", "PP2Calpha, PP2AC"], ["Entrez", "5515"], ["Ensembl", "ENSG00000113575"], ["RefSeq", "NM_002715"], ["UniProt", "P67775"], ["Note", "Cα, main catalytic isoform"]]}, {"symbol": "PPP2CB", "props": [["Full name", "Serine/threonine-protein phosphatase 2A catalytic subunit beta isoform"], ["Function", "Catalytic subunit of protein phosphatase 2A (PP2A), a serine/threonine phosphatase involved in the regulation of a wide variety of enzymes, signal transduction pathways, and cellular events (Probable). PP2A can modulate the activity of phosphorylase B kinase, casein kinase 2, mitogen-stimulated S6 kinase, and MAP-2 kinase."], ["Location", "Cytoplasm, Nucleus, Chromosome, centromere, Cytoplasm, cytoskeleton, spindle pole"], ["HGNC", "HGNC:9300"], ["HGNC symbol", "PPP2CB"], ["HGNC aliases", "PP2Abeta"], ["Entrez", "5516"], ["Ensembl", "ENSG00000104695"], ["RefSeq", "NM_001009552"], ["UniProt", "P62714"], ["Note", "Cβ, minor catalytic isoform"]]}]</data>
