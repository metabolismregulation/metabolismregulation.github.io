      <data key="d121">CALM1; CALM2; CALM3</data>
      <data key="d122">[{"symbol": "CALM1", "props": [["Full name", "Calmodulin-1"], ["Function", "Calmodulin acts as part of a calcium signal transduction pathway by mediating the control of a large number of enzymes, ion channels, aquaporins and other proteins through calcium-binding. Calcium-binding is required for the activation of calmodulin."], ["Location", "Cytoplasm, cytoskeleton, spindle, Cytoplasm, cytoskeleton, spindle pole, Cytoplasm, cytoskeleton, microtubule organizing center, centrosome, Cell projection, cilium, flagellum"], ["HGNC", "HGNC:1442"], ["HGNC symbol", "CALM1"], ["HGNC aliases", "CAMI, PHKD, DD132, PHKD1, CALML2"], ["Entrez", "801"], ["Ensembl", "ENSG00000198668"], ["RefSeq", "NM_001363669"], ["UniProt", "P0DP23"], ["Note", "Identical calmodulin protein, ubiquitous"]]}, {"symbol": "CALM2", "props": [["Full name", "Calmodulin-2"], ["Function", "Calmodulin acts as part of a calcium signal transduction pathway by mediating the control of a large number of enzymes, ion channels, aquaporins and other proteins through calcium-binding. Calcium-binding is required for the activation of calmodulin."], ["Location", "Cytoplasm, cytoskeleton, spindle, Cytoplasm, cytoskeleton, spindle pole, Cytoplasm, cytoskeleton, microtubule organizing center, centrosome"], ["HGNC", "HGNC:1445"], ["HGNC symbol", "CALM2"], ["HGNC aliases", "PHKD, PHKD2, CAMII"], ["Entrez", "805"], ["Ensembl", "ENSG00000143933"], ["RefSeq", "NM_001743"], ["UniProt", "P0DP24"], ["Note", "Identical calmodulin protein, ubiquitous"]]}, {"symbol": "CALM3", "props": [["Full name", "Calmodulin-3"], ["Function", "Calmodulin acts as part of a calcium signal transduction pathway by mediating the control of a large number of enzymes, ion channels, aquaporins and other proteins through calcium-binding. Calcium-binding is required for the activation of calmodulin."], ["Location", "Cytoplasm, cytoskeleton, spindle, Cytoplasm, cytoskeleton, spindle pole, Cytoplasm, cytoskeleton, microtubule organizing