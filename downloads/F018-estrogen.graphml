          <data key="d34" xml:space="preserve">[{"symbol": "ADCY1", "props": [["Full name", "Adenylate cyclase type 1"], ["Alternative names", "ATP pyrophosphate-lyase 1; Adenylate cyclase type I; Adenylyl cyclase 1; Ca(2+)/calmodulin-activated adenylyl cyclase"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Mediates responses to increased cellular Ca(2+)/calmodulin levels."], ["Location", "Membrane, Cell membrane, Cytoplasm, Membrane raft"], ["HGNC", "HGNC:232"], ["HGNC symbol", "ADCY1"], ["Previous symbols", "DFNB44"], ["Alias symbols", "AC1"], ["Entrez", "107"], ["Ensembl", "ENSG00000164742"], ["RefSeq", "NM_021116"], ["UniProt", "Q08828"], ["Note", "Brain, Ca2+/calmodulin-stimulated"]]}, {"symbol": "ADCY2", "props": [["Full name", "Adenylate cyclase type 2"], ["Alternative names", "ATP pyrophosphate-lyase 2; Adenylate cyclase type II; Adenylyl cyclase 2"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Down-stream signaling cascades mediate changes in gene expression patterns and lead to increased IL6 production."], ["Location", "Membrane, Cell membrane, Cytoplasm"], ["HGNC", "HGNC:233"], ["HGNC symbol", "ADCY2"], ["Alias symbols", "HBAC2, KIAA1060, AC2"], ["Entrez", "108"], ["Ensembl", "ENSG00000078295"], ["RefSeq", "NM_020546"], ["UniProt", "Q08462"], ["Note", "Brain and lung, Gβγ-stimulated"]]}, {"symbol": "ADCY3", "props": [["Full name", "Adenylate cyclase type 3"], ["Alternative names", "ATP pyrophosphate-lyase 3; Adenylate cyclase type III; Adenylate cyclase, olfactive type; Adenylyl cyclase 3"], ["Function", "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Participates in signaling cascades triggered by odorant receptors via its function in cAMP biosynthesis: specifically activated by G alpha protein GNAL/G(olf) in olfactory epithelium."], ["Location", "Cell membrane, Cell projection, cilium membr