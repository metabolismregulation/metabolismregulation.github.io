      <data key="d122">[{"symbol": "MAPK3", "props": [["Full name", "Mitogen-activated protein kinase 3"], ["Alternative names", "ERT2; Extracellular signal-regulated kinase 1; Insulin-stimulated MAP2 kinase; MAP kinase isoform p44; Microtubule-associated protein 2 kinase; p44-ERK1"], ["Function", "Serine/threonine kinase which acts as an essential component of the MAP kinase signal transduction pathway. MAPK1/ERK2 and MAPK3/ERK1 are the 2 MAPKs which play an important role in the MAPK/ERK cascade."], ["Location", "Cytoplasm, Nucleus, Membrane, caveola, Cell junction, focal adhesion"], ["HGNC", "HGNC:6877"], ["HGNC symbol", "MAPK3"], ["HGNC aliases", "ERK1, p44mapk, p44erk1, ERK-1, PRKM3"], ["Entrez", "5595"], ["Ensembl", "ENSG00000102882"], ["RefSeq", "NM_001040056"], ["UniProt", "P27361"], ["Note", "Phosphorylates CAD"]]}, {"symbol": "MAPK1", "props": [["Full name", "Mitogen-activated protein kinase 1"], ["Alternative names", "ERT1; Extracellular signal-regulated kinase 2; MAP kinase isoform p42; Mitogen-activated protein kinase 2"], ["Function", "Serine/threonine kinase which acts as an essential component of the MAP kinase signal transduction pathway. MAPK1/ERK2 and MAPK3/ERK1 are the 2 MAPKs which play an important role in the MAPK/ERK cascade."], ["Location", "Cytoplasm, cytoskeleton, spindle, Nucleus, Cytoplasm, cytoskeleton, microtubule organizing center, centrosome, Cytoplasm, Membrane, caveola, Cell junction, focal adhesion"], ["HGNC", "HGNC:6871"], ["HGNC symbol", "MAPK1"], ["HGNC aliases", "ERK, ERK2, p41mapk, MAPK2, PRKM2, PRKM1"], ["Entrez", "5594"], ["Ensembl", "ENSG00000100030"], ["RefSeq", "NM_002745"], ["UniProt", "P28482"], ["Note", "Phosphorylates CAD"]]}]</data>
