              <data key="d13" xml:space="preserve"><![CDATA[BCOADC-E2, BCKAD-E2, BCKDH-E2]]></data>
              <data key="d14" xml:space="preserve"><![CDATA[1629]]></data>
              <data key="d15" xml:space="preserve"><![CDATA[ENSG00000137992]]></data>
              <data key="d16" xml:space="preserve"><![CDATA[NM_001918]]></data>
              <data key="d17" xml:space="preserve"><![CDATA[P11182]]></data>
