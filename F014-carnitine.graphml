          <data key="d26" xml:space="preserve"><![CDATA[[{"symbol": "PRKACA", "props": [["Full name", "cAMP-dependent protein kinase catalytic subunit alpha"], ["Function", "Phosphorylates a large number of substrates in the cytoplasm and the nucleus. Phosphorylates CDC25B, ABL1, NFKB1, CLDN3, histone H1.4 (H1-4), PSMC5/RPT6, PJA2, RYR2, RORA, SLC6A6, SOX9, UHRF1 and VASP."], ["Location", "Cytoplasm, Cell membrane, Membrane, Nucleus, Mitochondrion, Cell projection, cilium, flagellum, Cytoplasmic vesicle, secretory vesicle, acrosome"], ["HGNC", "HGNC:9380"], ["HGNC symbol", "PRKACA"], ["HGNC aliases", "PKACa"], ["Entrez", "5566"], ["Ensembl", "ENSG00000072062"], ["RefSeq", "NM_002730"], ["UniProt", "P17612"], ["Note", "Cα, ubiquitous"]]}, {"symbol": "PRKACB", "props": [["Full name", "cAMP-dependent protein kinase catalytic subunit beta"], ["Function", "Mediates cAMP-dependent signaling triggered by receptor binding to GPCRs. PKA activation regulates diverse cellular processes such as cell proliferation, the cell cycle, differentiation and regulation of microtubule dynamics, chromatin condensation and decondensation, nuclear envelope disassembly and reassembly, as well as regulation of intracellular transport mechanisms and ion flux."], ["Location", "Cytoplasm, Cell membrane, Membrane, Nucleus"], ["HGNC", "HGNC:9381"], ["HGNC symbol", "PRKACB"], ["HGNC aliases", "PKACb"], ["Entrez", "5567"], ["Ensembl", "ENSG00000142875"], ["RefSeq", "NM_182948"], ["UniProt", "P22694"], ["Note", "Cβ, ubiquitous, high in brain"]]}, {"symbol": "PRKACG", "props": [["Full name", "cAMP-dependent protein kinase catalytic subunit gamma"], ["Function", "Phosphorylates a large number of substrates in the cytoplasm and the nucleus"], ["HGNC", "HGNC:9382"], ["HGNC symbol", "PRKACG"], ["HGNC aliases", "PKACg"], ["Entrez", "5568"], ["Ensembl", "ENSG00000165059"], ["RefSeq", "NM_002732"], ["UniProt", "P22612"], ["Note", "Cγ, testis"]]}]]]></data>
