      <data key="d26" xml:space="preserve">[{"symbol": "AKT1", "props": [["Full name", "RAC-alpha serine/threonine-protein kinase"], ["Alternative names", "Protein kinase B; Protein kinase B alpha; Proto-oncogene c-Akt; RAC-PK-alpha"], ["Function", "AKT1 is one of 3 closely related serine/threonine-protein kinases (AKT1, AKT2 and AKT3) called the AKT kinase, and which regulate many processes including metabolism, proliferation, cell survival, growth and angiogenesis. This is mediated through serine and/or threonine phosphorylation of a range of downstream substrates."], ["Location", "Cytoplasm, Nucleus, Cell membrane, Mitochondrion intermembrane space"], ["HGNC", "HGNC:391"], ["HGNC symbol", "AKT1"], ["Alias symbols", "RAC, PKB, PRKBA, AKT, RAC-alpha"], ["Entrez", "207"], ["Ensembl", "ENSG00000142208"], ["RefSeq", "NM_005163"], ["UniProt", "P31749"], ["Note", "Ubiquitous, growth and survival"]]}, {"symbol": "AKT2", "props": [["Full name", "RAC-beta serine/threonine-protein kinase"], ["Alternative names", "Protein kinase Akt-2; Protein kinase B beta; RAC protein kinase beta"], ["Function", "Serine/threonine kinase closely related to AKT1 and AKT3. All 3 enzymes, AKT1, AKT2 and AKT3, are collectively known as AKT kinase."], ["Location", "Cytoplasm, Nucleus, Cell membrane, Early endosome"], ["HGNC", "HGNC:392"], ["HGNC symbol", "AKT2"], ["Alias symbols", "PKBβ"], ["Entrez", "208"], ["Ensembl", "ENSG00000105221"], ["RefSeq", "NM_001626"], ["UniProt", "P31751"], ["Note", "Insulin-responsive tissues, glucose metabolism"]]}, {"symbol": "AKT3", "props": [["Full name", "RAC-gamma serine/threonine-protein kinase"], ["Alternative names", "Protein kinase Akt-3; Protein kinase B gamma; RAC-PK-gamma; STK-2"], ["Function", "AKT3 is one of 3 closely related serine/threonine-protein kinases (AKT1, AKT2 and AKT3) called the AKT kinase, and which regulate many processes including metabolism, proliferation, cell survival, growth and angiogenesis. This is mediated through serine and/or 