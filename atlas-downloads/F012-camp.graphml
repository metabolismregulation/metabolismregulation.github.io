      <data key="d26" xml:space="preserve">[{"symbol": "PIK3CA", "props": [["Full name", "Phosphatidylinositol 4,5-bisphosphate 3-kinase catalytic subunit alpha isoform"], ["Alternative names", "Phosphatidylinositol 4,5-bisphosphate 3-kinase 110 kDa catalytic subunit alpha; Phosphoinositide 3-kinase alpha; Phosphoinositide-3-kinase catalytic alpha polypeptide; Serine/threonine protein kinase PIK3CA"], ["Function", "Phosphoinositide-3-kinase (PI3K) phosphorylates phosphatidylinositol (PI) and its phosphorylated derivatives at position 3 of the inositol ring to produce 3-phosphoinositides. Uses ATP and PtdIns(4,5)P2 (phosphatidylinositol 4,5-bisphosphate) to generate phosphatidylinositol 3,4,5-trisphosphate (PIP3)."], ["HGNC", "HGNC:8975"], ["HGNC symbol", "PIK3CA"], ["Alias symbols", "PI3K"], ["Entrez", "5290"], ["Ensembl", "ENSG00000121879"], ["RefSeq", "NM_006218"], ["UniProt", "P42336"], ["Note", "p110α catalytic, main insulin-signalling isoform"]]}, {"symbol": "PIK3CB", "props": [["Full name", "Phosphatidylinositol 4,5-bisphosphate 3-kinase catalytic subunit beta isoform"], ["Alternative names", "Phosphatidylinositol 4,5-bisphosphate 3-kinase 110 kDa catalytic subunit beta; Serine/threonine protein kinase PIK3CB"], ["Function", "Phosphoinositide-3-kinase (PI3K) phosphorylates phosphatidylinositol derivatives at position 3 of the inositol ring to produce 3-phosphoinositides. Uses ATP and PtdIns(4,5)P2 (phosphatidylinositol 4,5-bisphosphate) to generate phosphatidylinositol 3,4,5-trisphosphate (PIP3)."], ["Location", "Cytoplasm, Nucleus"], ["HGNC", "HGNC:8976"], ["HGNC symbol", "PIK3CB"], ["Previous symbols", "PIK3C1"], ["Entrez", "5291"], ["Ensembl", "ENSG00000051382"], ["RefSeq", "NM_001256045"], ["UniProt", "P42338"], ["Note", "p110β catalytic, ubiquitous"]]}, {"symbol": "PIK3R1", "props": [["Full name", "Phosphatidylinositol 3-kinase regulatory subunit alpha"], ["Alternative names", "Phosphatidylinositol 3-kinase 85 kDa regulatory subunit alpha"], ["Function", "Binds to activated (phosphorylated) protein-Tyr kinases, through its SH2 domain, and acts as an adapter, mediating the association of the p110 catalytic unit to the plasma membrane. Necessary for the insulin-stimulated increase in glucose uptake and glycogen synthesis in insulin-sensitive tissues."], ["Location", "Cytoplasm"], ["HGNC", "HGNC:8979"], ["HGNC symbol", "PIK3R1"], ["Alias symbols", "GRB1, p85-ALPHA, p85, p85alpha"], ["Entrez", "5295"], ["Ensembl", "ENSG00000145675"], ["RefSeq", "NM_181504"], ["UniProt", "P27986"], ["Note", "p85α regulatory, most abundant"]]}, {"symbol": "PIK3R2", "props": [["Full name", "Phosphatidylinositol 3-kinase regulatory subunit beta"], ["Alternative names", "Phosphatidylinositol 3-kinase 85 kDa regulatory subunit beta"], ["Function", "Regulatory subunit of phosphoinositide-3-kinase (PI3K), a kinase that phosphorylates PtdIns(4,5)P2 (Phosphatidylinositol 4,5-bisphosphate) to generate phosphatidylinositol 3,4,5-trisphosphate (PIP3). PIP3 plays a key role by recruiting PH domain-containing proteins to the membrane, including AKT1 and PDPK1, activating signaling cascades involved in cell growth, survival, proliferation, motility and morphology."], ["HGNC", "HGNC:8980"], ["HGNC symbol", "PIK3R2"], ["Alias symbols", "P85B, p85, p85beta, p85-BETA"], ["Entrez", "5296"], ["Ensembl", "ENSG00000105647"], ["RefSeq", "NM_005027"], ["UniProt", "O00459"], ["Note", "p85β regulatory, broad expression"]]}, {"symbol": "PIK3R3", "props": [["Full name", "Phosphatidylinositol 3-kinase regulatory subunit gamma"], ["Alternative names", "Phosphatidylinositol 3-kinase 55 kDa regulatory subunit gamma; p55PIK"], ["Function", "Binds to activated (phosphorylated) protein-tyrosine kinases through its SH2 domain and regulates their kinase activity. During insulin stimulation, it also binds to IRS-1"], ["HGNC", "HGNC:8981"], ["HGNC symbol", "PIK3R3"], ["Alias symbols", "p55"], ["Entrez", "8503"], ["Ensembl", "ENSG00000117461"], ["RefSeq", "NM_003629"], ["UniProt", "Q92569"], ["Note", "p55γ regulatory, brain and testis"]]}]</data>
