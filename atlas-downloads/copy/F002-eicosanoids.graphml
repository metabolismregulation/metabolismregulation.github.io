    <node id="n15">
      <data key="d100">RAF proto-oncogene serine/threonine-protein kinase</data>
      <data key="d101">Proto-oncogene c-RAF; Raf-1</data>
      <data key="d104">Serine/threonine-protein kinase that acts as a regulatory link between the membrane-associated Ras GTPases and the MAPK/ERK cascade, and this critical regulatory link functions as a switch determining cell fate decisions including proliferation, differentiation, apoptosis, survival and oncogenic transformation. RAF1 activation initiates a mitogen-activated protein kinase (MAPK) cascade that comprises a sequential phosphorylation of the dual-specific MAPK kinases (MAP2K1/MEK1 and MAP2K2/MEK2) and the extracellular signal-regulated kinases (MAPK3/ERK1 and MAPK1/ERK2).</data>
      <data key="d105">Cytoplasm, Cell membrane, Mitochondrion, Nucleus</data>
      <data key="d107">HGNC:9829</data>
      <data key="d108">RAF1</data>
      <data key="d109">Raf-1, c-Raf, CRAF</data>
      <data key="d110">5894</data>
      <data key="d111">ENSG00000132155</data>
      <data key="d112">NM_002880</data>
      <data key="d113">P04049</data>
      <data key="d119">Activates MEK1/2</data>
      <data key="d4" xml:space="preserve">https://www.uniprot.org/uniprotkb/P04049</data>
