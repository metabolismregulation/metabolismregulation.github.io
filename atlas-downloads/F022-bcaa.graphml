        <node id="n13::n3">
          <data key="d4" xml:space="preserve"><![CDATA[Dihydrolipoyl dehydrogenase, mitochondrial]]></data>
          <data key="d5" xml:space="preserve"><![CDATA[Dihydrolipoamide dehydrogenase; Glycine cleavage system L protein]]></data>
          <data key="d6" xml:space="preserve"/>
          <data key="d7" xml:space="preserve"/>
          <data key="d8" xml:space="preserve"><![CDATA[Lipoamide dehydrogenase is a component of the glycine cleavage system as well as an E3 component of three alpha-ketoacid dehydrogenase complexes (pyruvate-, alpha-ketoglutarate-, and branched-chain amino acid-dehydrogenase complex). The 2-oxoglutarate dehydrogenase complex is mainly active in the mitochondrion.]]></data>
