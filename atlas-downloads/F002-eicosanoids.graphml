    <node id="n56">
      <data key="d120">Phospholipase C beta</data>
      <data key="d121">PLCB1; PLCB2; PLCB3; PLCB4</data>
      <data key="d122">[{"symbol": "PLCB1", "props": [["Full name", "1-phosphatidylinositol 4,5-bisphosphate phosphodiesterase beta-1"], ["Alternative names", "PLC-154; Phosphoinositide phospholipase C-beta-1; Phospholipase C-I; Phospholipase C-beta-1"], ["Function", "Catalyzes the hydrolysis of 1-phosphatidylinositol 4,5-bisphosphate into diacylglycerol (DAG) and inositol 1,4,5-trisphosphate (IP3) and mediates intracellular signaling downstream of G protein-coupled receptors. Regulates the function of the endothelial barrier"], ["Location", "Nucleus membrane, Cytoplasm"], ["HGNC", "HGNC:15917"], ["HGNC symbol", "PLCB1"], ["Alias symbols", "KIAA0581, PLC-I, PLC154"], ["Entrez", "23236"], ["Ensembl", "ENSG00000182621"], ["RefSeq", "NM_015192"], ["UniProt", "Q9NQ66"]]}, {"symbol": "PLCB2", "props": [["Full name", "1-phosphatidylinositol 4,5-bisphosphate phosphodiesterase beta-2"], ["Alternative names", "Phosphoinositide phospholipase C-beta-2; Phospholipase C-beta-2"], ["Function", "The production of the second messenger molecules diacylglycerol (DAG) and inositol 1,4,5-trisphosphate (IP3) is mediated by activated phosphatidylinositol-specific phospholipase C enzymes. In neutrophils, participates in a phospholipase C-activating N-formyl peptide-activated GPCR (G protein-coupled receptor) signaling pathway by promoting RASGRP4 activation by DAG, to promote neutrophil functional responses"], ["HGNC", "HGNC:9055"], ["HGNC symbol", "PLCB2"], ["Alias symbols", "FLJ38135"], ["Entrez", "5330"], ["Ensembl", "ENSG00000137841"], ["RefSeq", "NM_001284297"], ["UniProt", "Q00722"]]}, {"symbol": "PLCB3", "props": [["Full name", "1-phosphatidylinositol 4,5-bisphosphate phosphodiesterase beta-3"], ["Alternative names", "Phosphoinositide phospholipase C-beta-3; Phospholipase C-beta-3"], ["Function", "Catalyzes the production of the second messenger molecules diacylglycerol (DAG) and inositol 1,4,5-trisphosphate (IP3). Key transducer of G protein-coupled receptor signaling: activated by G(q)/G(11) G alpha proteins downstream of G protein-coupled receptors activation."], ["Location", "Cytoplasm, Membrane, Nucleus"], ["HGNC", "HGNC:9056"], ["HGNC symbol", "PLCB3"], ["Entrez", "5331"], ["Ensembl", "ENSG00000149782"], ["RefSeq", "NM_000932"], ["UniProt", "Q01970"]]}, {"symbol": "PLCB4", "props": [["Full name", "1-phosphatidylinositol 4,5-bisphosphate phosphodiesterase beta-4"], ["Alternative names", "Phosphoinositide phospholipase C-beta-4; Phospholipase C-beta-4"], ["Function", "Activated phosphatidylinositol-specific phospholipase C enzymes catalyze the production of the second messenger molecules diacylglycerol (DAG) and inositol 1,4,5-trisphosphate (IP3) involved in G protein-coupled receptor signaling pathways. PLCB4 is a direct effector of the endothelin receptor signaling pathway that plays an essential role in lower jaw and middle ear structures development"], ["Location", "Cell membrane"], ["HGNC", "HGNC:9059"], ["HGNC symbol", "PLCB4"], ["Entrez", "5332"], ["Ensembl", "ENSG00000101333"], ["RefSeq", "NM_000933"], ["UniProt", "Q15147"]]}]</data>
