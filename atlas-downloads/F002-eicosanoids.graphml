    <node id="n59">
      <data key="d120">IP3 receptors</data>
      <data key="d121">ITPR1; ITPR2; ITPR3</data>
      <data key="d122">[{"symbol": "ITPR1", "props": [["Full name", "Inositol 1,4,5-trisphosphate-gated calcium channel ITPR1"], ["Alternative names", "IP3 receptor isoform 1; Inositol 1,4,5 trisphosphate receptor; Inositol 1,4,5-trisphosphate receptor type 1; Type 1 inositol 1,4,5-trisphosphate receptor"], ["Function", "Inositol 1,4,5-trisphosphate-gated calcium channel that, upon inositol 1,4,5-trisphosphate binding, mediates calcium release from the endoplasmic reticulum (ER). Undergoes conformational changes upon ligand binding, suggesting structural flexibility that allows the channel to switch from a closed state, capable of interacting with its ligands such as 1,4,5-trisphosphate and calcium, to an open state, capable of transferring calcium ions across the ER membrane."], ["Location", "Endoplasmic reticulum membrane, Cytoplasmic vesicle, secretory vesicle membrane, Cytoplasm, perinuclear region"], ["HGNC", "HGNC:6180"], ["HGNC symbol", "ITPR1"], ["Previous symbols", "SCA15, SCA16, SCA29"], ["Alias symbols", "Insp3r1, IP3R1, ACV, PPP1R94"], ["Entrez", "3708"], ["Ensembl", "ENSG00000150995"], ["RefSeq", "NM_002222"], ["UniProt", "Q14643"]]}, {"symbol": "ITPR2", "props": [["Full name", "Inositol 1,4,5-trisphosphate-gated calcium channel ITPR2"], ["Alternative names", "IP3 receptor isoform 2; Inositol 1,4,5-trisphosphate receptor type 2; Type 2 inositol 1,4,5-trisphosphate receptor"], ["Function", "Inositol 1,4,5-trisphosphate-gated calcium channel that upon inositol 1,4,5-trisphosphate binding transports calcium from the endoplasmic reticulum lumen to cytoplasm. Exists in two states; a long-lived closed state where the channel is essentially 'parked' with only very rare visits to an open state and that ligands facilitate the transition from the 'parked' state into a 'drive' mode represented by periods of bursting activity"], ["Location", "Endoplasmic reticulum membrane, Cytoplasmic vesicle, secretory vesicle membrane"], ["HGNC", "HGNC:6181"], ["HGNC symbol", "ITPR2"], ["Alias symbols", "IP3R2, CFAP48"], ["Entrez", "3709"], ["Ensembl", "ENSG00000123104"], ["RefSeq", "NM_002223"], ["UniProt", "Q14571"]]}, {"symbol": "ITPR3", "props": [["Full name", "Inositol 1,4,5-trisphosphate-gated calcium channel ITPR3"], ["Alternative names", "IP3 receptor isoform 3; Type 3 inositol 1,4,5-trisphosphate receptor"], ["Function", "Inositol 1,4,5-trisphosphate-gated calcium channel that, upon 1D-myo-inositol 1,4,5-trisphosphate binding, transports calcium from the endoplasmic reticulum lumen to cytoplasm, thus releasing the intracellular calcium and therefore participates in cellular calcium ion homeostasis. 1D-myo-inositol 1,4,5-trisphosphate binds to the ligand-free channel without altering its global conformation, yielding the low-energy resting state, then progresses through resting-to preactivated transitions to the higher energy preactivated state, which increases affinity for calcium, promoting binding of the low basal cytosolic calcium at the juxtamembrane domain (JD) site, favoring the transition through the ensemble of high-energy intermediate states along the trajectory to the fully-open activated state."], ["Location", "Endoplasmic reticulum membrane, Cytoplasmic vesicle, secretory vesicle membrane"], ["HGNC", "HGNC:6182"], ["HGNC symbol", "ITPR3"], ["Alias symbols", "IP3R3"], ["Entrez", "3710"], ["Ensembl", "ENSG00000096433"], ["RefSeq", "NM_002224"], ["UniProt", "Q14573"]]}]</data>
      <data key="d4" xml:space="preserve"/>
