      <data key="d121">MAP2K1; MAP2K2</data>
      <data key="d122">[{"symbol": "MAP2K1", "props": [["Full name", "Dual specificity mitogen-activated protein kinase kinase 1"], ["Alternative names", "ERK activator kinase 1; MAPK/ERK kinase 1"], ["Function", "Dual specificity protein kinase which acts as an essential component of the MAP kinase signal transduction pathway. Binding of extracellular ligands such as growth factors, cytokines and hormones to their cell-surface receptors activates RAS and this initiates RAF1 activation."], ["Location", "Cytoplasm, cytoskeleton, microtubule organizing center, centrosome, Cytoplasm, cytoskeleton, microtubule organizing center, spindle pole body, Cytoplasm, Nucleus, Membrane"], ["HGNC", "HGNC:6840"], ["HGNC symbol", "MAP2K1"], ["Previous symbols", "PRKMK1"], ["Alias symbols", "MEK1, MAPKK1, MKK1"], ["Entrez", "5604"], ["Ensembl", "ENSG00000169032"], ["RefSeq", "NM_001411065"], ["UniProt", "Q02750"], ["Note", "Activates ERK1/2"]]}, {"symbol": "MAP2K2", "props": [["Full name", "Dual specificity mitogen-activated protein kinase kinase 2"], ["Alternative names", "ERK activator kinase 2; MAPK/ERK kinase 2"], ["Function", "Catalyzes the concomitant phosphorylation of a threonine and a tyrosine residue in a Thr-Glu-Tyr sequence located in MAP kinases. Activates the ERK1 and ERK2 MAP kinases."], ["Location", "Cytoplasm, Membrane"], ["HGNC", "HGNC:6842"], ["HGNC symbol", "MAP2K2"], ["Previous symbols", "PRKMK2"], ["Alias symbols", "MEK2, MKK2"], ["Entrez", "5605"], ["Ensembl", "ENSG00000126934"], ["RefSeq", "NM_030662"], ["UniProt", "P36507"], ["Note", "Activates ERK1/2"]]}]</data>
      <data key="d4" xml:space="preserve"/>
      <data key="d6">
