    <node id="n6">
      <data key="d121">PTGS1; PTGS2</data>
      <data key="d122">[{"symbol": "PTGS1", "props": [["Full name", "Prostaglandin G/H synthase 1"], ["Alternative names", "Cyclooxygenase-1; Prostaglandin H2 synthase 1; Prostaglandin-endoperoxide synthase 1"], ["Function", "Dual cyclooxygenase and peroxidase that plays an important role in the biosynthesis pathway of prostanoids, a class of C20 oxylipins mainly derived from arachidonate ((5Z,8Z,11Z,14Z)-eicosatetraenoate, AA, C20:4(n-6)), with a particular role in the inflammatory response. The cyclooxygenase activity oxygenates AA to the hydroperoxy endoperoxide prostaglandin G2 (PGG2), and the peroxidase activity reduces PGG2 to the hydroxy endoperoxide prostaglandin H2 (PGH2), the precursor of all 2-series prostaglandins and thromboxanes."], ["Location", "Microsome membrane, Endoplasmic reticulum membrane"], ["HGNC", "HGNC:9604"], ["HGNC symbol", "PTGS1"], ["Alias symbols", "COX1, PGHS-1, PTGHS"], ["Entrez", "5742"], ["Ensembl", "ENSG00000095303"], ["RefSeq", "NM_000962"], ["UniProt", "P23219"], ["Note", "Constitutive cyclooxygenase"]]}, {"symbol": "PTGS2", "props": [["Full name", "Prostaglandin G/H synthase 2"], ["Alternative names", "Cyclooxygenase-2; PHS II; Prostaglandin H2 synthase 2; Prostaglandin-endoperoxide synthase 2"], ["Function", "Dual cyclooxygenase and peroxidase in the biosynthesis pathway of prostanoids, a class of C20 oxylipins mainly derived from arachidonate ((5Z,8Z,11Z,14Z)-eicosatetraenoate, AA, C20:4(n-6)), with a particular role in the inflammatory response. The cyclooxygenase activity oxygenates AA to the hydroperoxy endoperoxide prostaglandin G2 (PGG2), and the peroxidase activity reduces PGG2 to the hydroxy endoperoxide prostaglandin H2 (PGH2), the precursor of all 2-series prostaglandins and thromboxanes."], ["Location", "Microsome membrane, Endoplasmic reticulum membrane, Nucleus inner membrane, Nucleus outer membrane"], ["HGNC", "HGNC:9605"], ["HGNC symbol", "PTGS2"], ["Alias symbols", "COX2"], ["Entrez", "5743"], ["Ensembl", "ENSG00000073756"], ["RefSeq", "NM_000963"], ["UniProt", "P35354"], ["Note", "Inducible cyclooxygenase"]]}]</data>
