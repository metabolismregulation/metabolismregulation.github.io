      <data key="d11" xml:space="preserve"><![CDATA[horizontal]]></data>
      <data key="d12" xml:space="preserve"><![CDATA[Type II inositol 1,4,5-trisphosphate 5-phosphatase]]></data>
      <data key="d13" xml:space="preserve"><![CDATA[75 kDa inositol polyphosphate-5-phosphatase; Phosphoinositide 5-phosphatase]]></data>
      <data key="d14"/>
      <data key="d15"/>
      <data key="d16" xml:space="preserve"><![CDATA[Regulates phosphatidylinositol 4,5-bisphosphate (PtdIns(4,5)P2) cellular levels by cleaving the phosphate at the 5-position producing PtdIns(4)P. Also hydrolyzes the 5-position phosphate from inositol 1,4,5-trisphosphate (Ins(1,4,5)P3), thereby modulating cellular signaling events]]></data>
      <data key="d17" xml:space="preserve"><![CDATA[Cytoplasm, cytosol, Endoplasmic reticulum-Golgi intermediate compartment, Early endosome membrane, Membrane, Cytoplasmic vesicle, phagosome membrane, Golgi apparatus]]></data>
