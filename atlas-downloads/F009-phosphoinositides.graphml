    <node id="n14">
      <data key="d4" xml:space="preserve"/>
      <data key="d5" xml:space="preserve"/>
      <data key="d6" xml:space="preserve"/>
      <data key="d7" xml:space="preserve"/>
      <data key="d8" xml:space="preserve"/>
      <data key="d9" xml:space="preserve"/>
      <data key="d10" xml:space="preserve"/>
      <data key="d11" xml:space="preserve"><![CDATA[horizontal]]></data>
      <data key="d12" xml:space="preserve"><![CDATA[Phosphatidylinositol 3,4,5-trisphosphate 3-phosphatase and dual-specificity protein phosphatase PTEN]]></data>
      <data key="d13" xml:space="preserve"><![CDATA[Inositol polyphosphate 3-phosphatase; Mutated in multiple advanced cancers 1; Phosphatase and tensin homolog]]></data>
      <data key="d14"/>
      <data key="d15"/>
      <data key="d16" xml:space="preserve"><![CDATA[Dual-specificity protein phosphatase, dephosphorylating tyrosine-, serine- and threonine-phosphorylated proteins. Also functions as a lipid phosphatase, removing the phosphate in the D3 position of the inositol ring of PtdIns(3,4,5)P3/phosphatidylinositol 3,4,5-trisphosphate, PtdIns(3,4)P2/phosphatidylinositol 3,4-diphosphate and PtdIns3P/phosphatidylinositol 3-phosphate with a preference for PtdIns(3,4,5)P3.]]></data>
      <data key="d17" xml:space="preserve"><![CDATA[Cytoplasm, Nucleus, Nucleus, PML body, Cell projection, dendritic spine, Postsynaptic density, Secreted]]></data>
      <data key="d18"/>
      <data key="d19" xml:space="preserve"><![CDATA[HGNC:9588]]></data>
      <data key="d20" xml:space="preserve"><![CDATA[PTEN]]></data>
      <data key="d101">BZS, MHAM</data>
