      <data key="d34" xml:space="preserve">[{"symbol": "SYNJ1", "props": [["Full name", "Polyphosphatidylinositol phosphatase SYNJ1"], ["Alternative names", "Synaptojanin-1"], ["Function", "Phosphatase that hydrolyzes phosphate groups from the inositol ring of phosphoinositides and inositol phosphates, in a domain-specific manner. The 5-PPase domain catalyzes removal of the 5-phosphate from substrates such as phosphatidylinositol-4,5-bisphosphate (PtdIns(4,5)P2), phosphatidylinositol-3,4,5-trisphosphate (PtdIns(3,4,5)P3), inositol-1,4,5-trisphosphate (Ins(1,4,5)P3) and inositol-1,3,4,5-tetrakisphosphate (Ins(1,3,4,5)P4)."], ["Location", "Cytoplasm, perinuclear region, Presynapse, Membrane"], ["HGNC", "HGNC:11503"], ["HGNC symbol", "SYNJ1"], ["Alias symbols", "INPP5G, PARK20"], ["Entrez", "8867"], ["Ensembl", "ENSG00000159082"], ["RefSeq", "NM_003895"], ["UniProt", "O43426"], ["Note", "Phosphoinositide phosphatase, neurons"]]}, {"symbol": "SYNJ2", "props": [["Full name", "Polyphosphatidylinositol phosphatase SYNJ2"], ["Alternative names", "Synaptojanin-2"], ["Function", "Phosphatase that hydrolyzes phosphate groups from the inositol ring of phosphoinositides and inositol phosphates, in a domain-specific manner. The 5-PPase domain catalyzes removal of the 5-phosphate from substrates such as phosphatidylinositol-4,5-bisphosphate (PtdIns(4,5)P2), phosphatidylinositol-3,4,5-trisphosphate (PtdIns(3,4,5)P3), inositol-1,4,5-trisphosphate (Ins(1,4,5)P3) and inositol-1,3,4,5-tetrakisphosphate (Ins(1,3,4,5)P4)."], ["Location", "Cytoplasm, Cell membrane, Cell projection, ruffle membrane, Presynapse, Cytoplasm, cytoskeleton"], ["HGNC", "HGNC:11504"], ["HGNC symbol", "SYNJ2"], ["Alias symbols", "INPP5H"], ["Entrez", "8871"], ["Ensembl", "ENSG00000078269"], ["RefSeq", "NM_003898"], ["UniProt", "O15056"], ["Note", "Phosphoinositide phosphatase"]]}]</data>
      <data key="d35" xml:space="preserve"/>
      <data key="d37">
