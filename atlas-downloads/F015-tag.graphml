      <graph edgedefault="directed" id="n19:">
        <node id="n19::n0">
          <data key="d100">Perilipin-1</data>
          <data key="d101">Lipid droplet-associated protein</data>
          <data key="d104">Modulator of adipocyte lipid metabolism. Coats lipid storage droplets to protect them from breakdown by hormone-sensitive lipase (HSL).</data>
          <data key="d105">Endoplasmic reticulum, Lipid droplet</data>
